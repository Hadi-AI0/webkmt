# ============================================================
# WebKMT server environment — copy to ".env" and fill in.
# NEVER commit the real .env (it is gitignored).
# Step-by-step instructions for every key: docs/API_KEYS.md
# ============================================================

PORT=8083
NODE_ENV=production
ALLOWED_ORIGINS=https://webkmt.com,https://www.webkmt.com,https://link.webkmt.com

# --- Supabase (REQUIRED: auth, leads/contacts, blog, KMT Link) ---
# Get from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google PageSpeed Insights (Website Analyzer performance + Speed Test) ---
# Get from: Google Cloud Console -> APIs & Services -> Credentials
# Restrict it: API = "PageSpeed Insights API" only, Application = your VPS IP
PAGE_SPEED_API_KEY=

# --- Google Gemini (Kemet chatbot) ---
# Get from: Google AI Studio (aistudio.google.com) -> API Keys
GEMINI_API_KEY=

# --- Cal.com booking (native booking modal — server/routes/cal.js) ---
# Get from: Cal.com -> Settings -> Security -> API Keys
CAL_API_KEY=
# Optional overrides (defaults shown):
# CAL_API_BASE=https://api.cal.com/v2
# CAL_EVENT_TYPE_ID=

# --- Scraper (Crawlee — server/services/scraper.js) ---
# No key needed. Self-hosted; nothing to configure.

# --- Optional tuning ---
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
