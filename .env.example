# ============================================================
# WebKMT server environment — copy to ".env" and fill in.
# NEVER commit the real .env (it is gitignored).
# ============================================================

PORT=8083
NODE_ENV=production
ALLOWED_ORIGINS=https://webkmt.com,https://www.webkmt.com,https://link.webkmt.com

# --- Supabase (auth, contacts/leads, blog, KMT Link) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini (Kemet chatbot) ---
GEMINI_API_KEY=

# --- Google PageSpeed Insights (Website Analyzer performance data) ---
PAGE_SPEED_API_KEY=

# --- Cal.com booking (native booking modal — server/routes/cal.js) ---
# Create the key in Cal.com -> Settings -> Security -> API Keys.
CAL_API_KEY=
# Optional overrides (defaults shown):
# CAL_API_BASE=https://api.cal.com/v2
# CAL_EVENT_TYPE_ID=
